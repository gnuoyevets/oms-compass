  "intraop": [
    {
      "group": "Time-out · before incision",
      "items": [
        {
          "id": "id",
          "text": "Patient, procedure, side and tooth numbers confirmed aloud against consent and imaging"
        },
        {
          "id": "cons",
          "text": "Consent signed, including alternatives and no treatment"
        },
        {
          "id": "alg",
          "text": "Allergies restated: local anesthetic, latex, chlorhexidine, antibiotics"
        },
        {
          "id": "gate",
          "text": "Medical gate items done: IE prophylaxis given, antithrombotic plan, SGLT2/GLP-1 timing"
        },
        {
          "id": "img",
          "text": "Imaging up; nerve and sinus proximity reviewed"
        },
        {
          "id": "kit",
          "text": "Implants, grafts, instruments and lot labels in the room"
        },
        {
          "id": "em",
          "text": "Suction, O₂ and emergency kit checked; team roles known"
        }
      ]
    },
    {
      "group": "If sedated",
      "items": [
        {
          "id": "mon",
          "text": "Monitors on and baseline recorded: SpO₂, BP, ECG, capnography"
        },
        {
          "id": "iv",
          "text": "IV patent; reversal agents and airway equipment at hand"
        },
        {
          "id": "npo",
          "text": "NPO, escort and GLP-1 status confirmed"
        }
      ]
    },
    {
      "group": "During · pause points",
      "items": [
        {
          "id": "la",
          "text": "Running local anesthetic total checked against weight-based maximum"
        },
        {
          "id": "pack",
          "text": "Throat pack or gauze screen in place"
        },
        {
          "id": "vit",
          "text": "Sedation vitals recorded at set intervals"
        },
        {
          "id": "stop",
          "text": "Stop and re-plan if bleeding is uncontrolled, a root is displaced, the sinus is opened, a nerve is exposed, or vitals change"
        }
      ]
    },
    {
      "group": "Sign-out · before the patient leaves the chair",
      "items": [
        {
          "id": "cnt",
          "text": "Throat pack and gauze removed and counted"
        },
        {
          "id": "frag",
          "text": "All teeth, roots and fragments accounted for"
        },
        {
          "id": "spec",
          "text": "Specimen labeled; requisition complete"
        },
        {
          "id": "lot",
          "text": "Implant and graft lot numbers recorded"
        },
        {
          "id": "hem",
          "text": "Hemostasis confirmed"
        },
        {
          "id": "po",
          "text": "Instructions, prescriptions and after-hours number given"
        },
        {
          "id": "dc",
          "text": "If sedated: discharge criteria met and escort present"
        }
      ]
    },
    {
      "group": "If All-on-X (full-arch, immediate load)",
      "items": [
        {
          "id": "axplan",
          "text": "Prosthetic plan confirmed before reduction: vertical dimension, midline, smile line and planned prosthesis space"
        },
        {
          "id": "axscan",
          "text": "Fiducial markers placed; photogrammetry or scans captured before surgery"
        },
        {
          "id": "axred",
          "text": "Bone reduction checked against the plan (or reduction guide); restorative space verified before implant placement. Low sinus exposed by reduction: ceramic bur near the sinus, or outline it and push up with a hand instrument"
        },
        {
          "id": "axguide",
          "text": "Surgical guide seated and stable; fixation pins secure; fit verified on the reduced ridge"
        },
        {
          "id": "axtq",
          "text": "Insertion torque recorded per implant; immediate loading only if torque and stability meet the plan, otherwise bury or delay. Posterior implants ≥4 mm diameter"
        },
        {
          "id": "axmua",
          "text": "Multi-unit abutments: angulation chosen, torqued per manufacturer, seating confirmed on radiograph"
        },
        {
          "id": "axconv",
          "text": "Conversion or pickup: passive fit, no soft-tissue blanching, screw channels sealed, occlusion even with no cantilever contact in excursions"
        },
        {
          "id": "axpost",
          "text": "Post-placement scan or photogrammetry captured; sockets grafted or PRF placed as planned; masseter botulinum toxin if planned"
        },
        {
          "id": "axrec",
          "text": "Implant and abutment positions, torques and lot numbers recorded; prosthesis screw torque noted; soft diet and no clenching reviewed with the patient"
        }
      ]
    }
  ],
